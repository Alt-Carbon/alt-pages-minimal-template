---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostRow from "../../components/PostRow.astro";
import { day, summary, writing } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await writing();
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p, others: posts.filter((o) => o.id !== p.id).slice(0, 3) } }));
}
const { post, others } = Astro.props;
const { Content } = await render(post);
---
<Base page="essay" title={post.data.title} description={summary(post)} image={`/og/writing/${post.id}.png`} published={post.data.date}>
  <h1>{post.data.title}</h1>
  <p class="stamp">{day(post.data.date)}</p>
  <Content />
  {others.length > 0 && (
    <nav class="more" aria-labelledby="more-h">
      <h2 id="more-h">More writing</h2>
      <ul class="rows">{others.map((o) => <PostRow post={o} blurb={false} />)}</ul>
      <a class="all" href="/writing">All writing</a>
    </nav>
  )}
</Base>
