---
// Every page: head, the rail, one main, and the footer that only shows on phones.
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/geist/wght-italic.css";
import "@fontsource-variable/eb-garamond/wght.css";
import "../styles/site.css";
import { ClientRouter } from "astro:transitions";
import Rail from "../components/Rail.astro";
import DevFontSwitch from "../components/DevFontSwitch.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import { about, accent, currentRole, day, freshness, origin, owner, pages, repo, shown, site, social, template } from "../lib/content";

// SEO and link previews are generated here from the content, so nobody fills them in by hand.
// `image` is the preview card under /og (see src/pages/og), `published` marks an essay.
interface Props { title?: string; description?: string; page: string; bodyClass?: string; image?: string; published?: Date }
const { title, description, page, bodyClass = "", image = `/og/${page === "404" ? "home" : page}.png`, published } = Astro.props;
const fresh = await freshness();
// A page that is switched off or empty still exists at its address, but search engines skip it.
const on = await shown();
const hidden = pages.some((p) => p.id === page && !on.has(p.id));
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const desc = description || `${site.oneLiner} ${site.intro}`.trim();
const base = origin(Astro.url);
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const url = base + path;
const img = base + image;
const sameAs = site.social.map((l) => l.url).filter((u) => /^https?:/.test(u));
const person = { "@type": "Person", name: site.name, url: `${base}/about`, ...(site.photo && { image: base + site.photo }), ...(about.shortBio && { description: about.shortBio }), ...(currentRole ? { jobTitle: currentRole.role, worksFor: { "@type": "Organization", name: currentRole.org, ...(currentRole.orgUrl && { url: currentRole.orgUrl }) } } : site.employer && { worksFor: { "@type": "Organization", name: site.employer, ...(site.employerUrl && { url: site.employerUrl }) } }), ...(sameAs.length && { sameAs }) };
const ld = page === "essay"
  ? { "@context": "https://schema.org", "@type": "BlogPosting", headline: title, description: desc, url, image: img, datePublished: published?.toISOString().slice(0, 10), author: person }
  : page === "about"
    ? { "@context": "https://schema.org", "@type": "ProfilePage", url, mainEntity: person }
    : page === "home"
      ? { "@context": "https://schema.org", "@type": "WebSite", name: site.name, url, author: person }
      : null;
---
<!doctype html>
<html lang="en" data-grain={site.grain ? "" : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111" media="(prefers-color-scheme: dark)">
<!-- A real load fades the content up (html.fresh); page changes use the view transition instead. -->
<script is:inline>document.documentElement.classList.add("fresh");addEventListener("astro:before-swap",function(){document.documentElement.classList.remove("fresh")},{once:true})</script>
<!-- Runs before first paint: applies a theme picked in the switcher, so there is no flash. -->
<script is:inline data-astro-rerun>try{if(location.search.indexOf("motion=off")>-1)document.documentElement.dataset.motion="off";var t=localStorage.getItem("theme");if(t==="light"||t==="dark"){document.documentElement.dataset.theme=t;document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.content=t==="dark"?"#111":"#fff"})}}catch(e){}</script>
<Fragment set:html={`<style>:root{--accent-light:${accent.light};--accent-dark:${accent.dark}}</style>`} />
<title>{fullTitle}</title>
<meta name="description" content={desc}>
<meta name="author" content={site.name}>
{hidden && <meta name="robots" content="noindex">}
{page !== "404" && <link rel="canonical" href={url}>}
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title || site.name}>
<meta property="og:description" content={desc}>
<meta property="og:type" content={page === "essay" ? "article" : "website"}>
<meta property="og:url" content={url}>
<meta property="og:image" content={img}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={fullTitle}>
{published && <meta property="article:published_time" content={published.toISOString().slice(0, 10)}>}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${site.name}: writing`}>
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />}
<meta name="portfolio-template" content={`${template.name}@${template.version}`}>
{owner && <meta name="portfolio-owner" content={owner}>}
{repo && <meta name="portfolio-repo" content={repo}>}
<link rel="alternate" type="application/json" href="/reading/view.json" title="Reading">
{import.meta.env.DEV && <DevFontSwitch />}
<!-- Pages change in place: the rail stays, the content fades up (see "Page changes" in site.css). -->
<ClientRouter fallback="none" />
</head>
<body class={bodyClass}>
<a class="skip" href="#content">Skip to content</a>
<div class="wrap">
  <Rail page={page} fresh={fresh} transition:name="rail" transition:animate="none" />
  <main id="content" transition:name="main" transition:animate="none" class:list={["page", { home: page === "home", essay: page === "essay", reading: page === "reading" }]}>
    <slot />
  </main>
  <footer transition:name="foot" transition:animate="none"><Fragment set:html={social()} /> · Updated {day(fresh.date)}<ThemeSwitch /></footer>
</div>
</body>
</html>
