---
// The bookshelf: the owner's Goodreads shelves, drawn in the browser in the style picked in
// Site settings (Bookshelf style). Until a profile is connected, a sample shelf is shown.
import Base from "../layouts/Base.astro";
import Shelf from "../components/Shelf.astro";
import { reading, site } from "../lib/content";
---
<Base page="reading" title="Reading" description={reading.intro}>
  <h1>Reading</h1>
  {reading.intro && <p>{reading.intro}</p>}
  <Shelf goodreads={site.goodreads} style={site.shelf} />
</Base>
