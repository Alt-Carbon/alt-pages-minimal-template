---
// The bookshelf. Filled by the browser from /reading/view.json and /reading/books.json, so books
// change without a rebuild. `style` picks one of the modules in src/scripts/shelf/; only that one is
// loaded. Without JavaScript it says where the books live.
interface Props { goodreads: string; style: string }
const { goodreads, style } = Astro.props;
// Every style's CSS is part of the Reading page itself (each is scoped to its own .shelf-<style>).
// Imported from the style modules instead, it would be injected at runtime and dropped when the
// router swaps the head, so a second visit to Reading came back unstyled.
import "../styles/shelf/journal.css";
import "../styles/shelf/gallery.css";
import "../styles/shelf/stacks.css";
import "../styles/shelf/turn.css";
---
<p class="src" id="shelf-src"></p>
<div id="shelf" class={`shelf-${style}`} data-goodreads={goodreads} data-style={style} data-dev={import.meta.env.DEV ? "" : undefined}>
  <noscript><p class="src">The shelf needs JavaScript. {goodreads && <a href={goodreads}>See it on Goodreads.</a>}</p></noscript>
</div>

<script>
  import { day, load, loadAll, type Style } from "../scripts/shelf/shared";
  import { renderList } from "../scripts/shelf/list";

  // Each style's script is its own chunk (its CSS is imported above); the plain list is the fallback.
  const styles: Record<string, () => Promise<{ render: Style }>> = {
    gallery: () => import("../scripts/shelf/gallery"),
    stacks: () => import("../scripts/shelf/stacks"),
    turn: () => import("../scripts/shelf/turn"),
    journal: () => import("../scripts/shelf/journal"),
  };

  // Pages change in place (ClientRouter), so this runs whenever the Reading page is shown.
  document.addEventListener("astro:page-load", async () => {
  const root = document.getElementById("shelf");
  if (!root) return;
  // Dev only: ?shelf=<style> previews another style without changing Site settings.
  if ("dev" in root.dataset) {
    const q = new URLSearchParams(location.search).get("shelf");
    if (q && q in styles) { root.dataset.style = q; root.className = `shelf-${q}`; }
  }
  const src = document.getElementById("shelf-src")!;
  const view = await load();
  if (!view || (!view.read.length && !view.reading.length)) {
    src.textContent = view?.syncing || root.dataset.goodreads
      ? "Reading the shelf from Goodreads for the first time. This takes under a minute; reload to see it."
      : "No Goodreads profile connected yet. Add one in the editor under Site settings.";
  } else {
    const shelf = await loadAll(view);
    let render: Style = renderList;
    try {
      render = (await styles[root.dataset.style!]?.())?.render ?? renderList;
    } catch {}
    render(shelf, root);
    const when = view.syncedAt ? `, ${day(view.syncedAt.slice(0, 10))}` : "";
    const where = root.dataset.goodreads ? `<a href="${root.dataset.goodreads}">Goodreads</a>` : "Goodreads";
    // The sample shelf (scripts/sample-shelf.mjs) carries no note; a synced one says when it was synced.
    src.innerHTML = view.sample ? "" : `Synced from my ${where} shelves${when}.`;
  }
  });
</script>
