---
// The home page: a short letter, then what's recent. The letter is the greeting and intro from Site
// settings, a line written from Experience (where they worked before), and the first line of Now.
// The feed mixes the latest writing, research and finished books by date; books and posts from Medium
// and Substack join in the browser from the site's own data (the script below). Nothing here needs
// filling in separately.
import Base from "../layouts/Base.astro";
import { about, currentRole, day, inline, now, research, shown, site, writing, writingPage } from "../lib/content";

const on = await shown();
const posts = await writing();
const res = [...research.items].sort((a, b) => b.year - a.year);
const nowLine = on.has("now") ? now.groups[0]?.items[0] : undefined;

// "Before Alt Carbon, I worked at X and Y." from the ended roles, each organisation once, in order.
const past = about.experience.filter((e) => e.end && e.org !== currentRole?.org).map((e) => e.org);
const orgs = past.filter((o, i) => past.indexOf(o) === i);
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);
const before = orgs.length ? `${currentRole ? `Before ${currentRole.org}, I` : "I"} worked at ${list(orgs)}.` : "";

// The feed before books. Research has only a year, so it sorts as mid-year.
type Item = { title: string; href: string; section: string; meta: string; sort: string };
const feed: Item[] = [
  ...(on.has("writing") ? posts.map((p) => ({ title: p.data.title, href: p.data.link || `/writing/${p.id}`, section: "Writing", meta: day(p.data.date), sort: p.data.date.toISOString().slice(0, 10) })) : []),
  ...(on.has("research") ? res.map((r) => ({ title: r.title, href: r.url || "/research", section: `Research · ${r.kind}`, meta: String(r.year), sort: `${r.year}-06-30` })) : []),
].sort((a, b) => b.sort.localeCompare(a.sort));
---
<Base page="home">
  <h1 class="vh">{site.name}</h1>
  <div class="letter">
    <p class="hi">{site.greeting || `Hi, I’m ${site.name.split(" ")[0]}.`}</p>
    <p>{site.oneLiner} {site.intro}</p>
    {before && <p>{before}</p>}
    {nowLine && <p>Right now: <Fragment set:html={inline(nowLine.charAt(0).toLowerCase() + nowLine.slice(1))} /> <a href="/now">Know more</a></p>}
  </div>
  <section class="recent" aria-labelledby="recent-h" hidden={!feed.length && !on.has("reading")}>
    <h2 id="recent-h">Recent</h2>
    <ul class="rows" data-reading={on.has("reading") ? "" : undefined} data-writing={on.has("writing") ? "" : undefined} data-hide={JSON.stringify(writingPage.hide)}>
      {feed.slice(0, 6).map((i) => <li data-sort={i.sort}><span><a href={i.href}>{i.title}</a><span class="n">{i.section}</span></span><span class="r">{i.meta}</span></li>)}
    </ul>
  </section>
</Base>

<script>
  // Finished books and posts on Medium or Substack join the feed by date, from the site's own data.
  import { load, monthYear, short, esc } from "../scripts/shelf/shared";
  import { insertByDate, loadPosts, visible, WHERE, day } from "../scripts/posts";
  document.addEventListener("astro:page-load", async () => {
    const ul = document.querySelector<HTMLElement>(".recent ul");
    if (!ul) return;
    const [v, pv] = await Promise.all(["reading" in ul.dataset ? load() : null, "writing" in ul.dataset ? loadPosts() : null]);
    const rows: HTMLLIElement[] = [];
    // Each row goes in before the first row older than it; the rows already there stay as they are.
    for (const b of (v?.read ?? []).filter((b) => b.readAt).slice(0, 6)) {
      const li = document.createElement("li");
      li.dataset.sort = b.readAt!;
      li.innerHTML = `<span><a href="/reading#book-${esc(b.id)}">${esc(short(b.title))}</a><span class="n">Reading · ${esc(b.author)}</span></span><span class="r">${monthYear(b.readAt)}</span>`;
      rows.push(li);
    }
    let hide: string[] = [];
    try { hide = JSON.parse(ul.dataset.hide || "[]"); } catch {}
    for (const p of pv ? visible(pv, hide).filter((p) => p.date).slice(0, 6) : []) {
      const li = document.createElement("li");
      li.dataset.sort = p.date!;
      li.innerHTML = `<span><a href="${esc(p.url)}">${esc(p.title)}</a><span class="n">Writing · ${WHERE[p.source]}</span></span><span class="r">${day(p.date)}</span>`;
      rows.push(li);
    }
    for (const li of rows) { li.className = "in"; insertByDate(ul, li); }
    while (ul.children.length > 6) ul.lastElementChild!.remove();
    ul.closest("section")!.hidden = !ul.children.length;
  });
</script>
