---
import Base from "../layouts/Base.astro";
import PostRow from "../components/PostRow.astro";
import { site, writing } from "../lib/content";
const posts = await writing();
---
<Base page="writing" title="Writing" description={`Essays and notes by ${site.name}.`}>
  <h1>Writing</h1>
  <ul class="rows">
    {posts.map((p) => <PostRow post={p} />)}
  </ul>
</Base>
