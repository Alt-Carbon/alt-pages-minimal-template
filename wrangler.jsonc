{
  // One Worker per person: this site's pages as static assets. The Deploy to
  // Cloudflare button reads this file to set the project up in your account.
  // The reading sync (a small script, a key-value store and a sync object) is
  // added to this file in the next step of the template.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-site",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": { "command": "npm run build" }
}
