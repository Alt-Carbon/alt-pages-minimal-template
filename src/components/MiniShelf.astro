---
// The latest books on the home page, as spines. Same data as the Reading page.
---
<a class="mini" href="/reading" aria-label="Reading: the latest books" id="mini"></a>
<script>
  import { load, renderMini } from "../scripts/shelf";
  const root = document.getElementById("mini")!;
  const view = await load();
  if (view && (view.read.length || view.reading.length)) renderMini(view, root);
  else root.textContent = "";
</script>
