---
import Base from "../layouts/Base.astro";
import { day, talks } from "../lib/content";
const items = [...talks.items].sort((a, b) => b.date.localeCompare(a.date));
---
<Base page="talks" title="Talks">
  <h1>Talks</h1>
  <ul class="rows">
    {items.map((t) => (
      <li>
        <span>
          {t.links[0] ? <a href={t.links[0].url}>{t.title}</a> : t.title}
          <span class="n">{t.where}{t.where && t.links.length > 0 && ". "}{t.links.length > 0 && <span class="lnk">{t.links.map((l) => <a href={l.url}>{l.label}</a>)}</span>}</span>
        </span>
        <span class="r">{day(t.date)}</span>
      </li>
    ))}
  </ul>
</Base>
